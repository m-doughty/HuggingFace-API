use Test;
use lib 'lib';
use HuggingFace::API;
use JSON::Fast;

plan 5;

# We pin to Cohee/distilbert-base-uncased-go-emotions-onnx at a
# known revision — that repo contains a small (~1.7KB) config.json
# with a stable id2label mapping, perfect for testing get-file
# and revision pinning without downloading the actual model
# weights. The SHA is from HF's published repo state and will
# not change.

constant $MODEL-ID = 'Cohee/distilbert-base-uncased-go-emotions-onnx';
constant $PINNED-REV = 'd22488bc83be87678f12eee8a3f65a65de94ef85';

my HuggingFace::API $hf .= new;

subtest 'get-file returns text content at pinned revision' => {
	plan 3;
	my Str:D $json = $hf.get-file($MODEL-ID, 'config.json', :revision($PINNED-REV));
	ok $json.chars > 100, "config.json is { $json.chars } chars";
	my %parsed = from-json($json);
	ok %parsed<id2label>:exists, 'has id2label key';
	is %parsed<id2label>.keys.elems, 28, 'id2label has 28 go-emotions labels';
};

subtest 'get-file defaults revision to main' => {
	plan 1;
	# Default revision is 'main' — just verify the call works
	# against HEAD of the default branch without explicit revision.
	my Str:D $json = $hf.get-file($MODEL-ID, 'config.json');
	ok $json.chars > 100, 'default revision (main) downloads successfully';
};

subtest 'get-file-blob returns binary content' => {
	plan 2;
	my Blob:D $blob = $hf.get-file-blob($MODEL-ID, 'config.json', :revision($PINNED-REV));
	ok $blob.bytes > 100, "blob is { $blob.bytes } bytes";
	my $decoded = $blob.decode('utf8');
	ok $decoded.contains('id2label'), 'blob decodes to JSON with expected content';
};

subtest 'get-file-to-file writes to disk' => {
	plan 3;
	my IO::Path $tmp = $*TMPDIR.add("hf-test-cfg-{$*PID}.json");
	$hf.get-file-to-file($MODEL-ID, 'config.json', $tmp,
		:revision($PINNED-REV));
	ok $tmp.e, 'file created';
	ok $tmp.s > 100, "file is { $tmp.s } bytes";
	my %parsed = from-json($tmp.slurp);
	is %parsed<id2label>.elems, 28, 'written file has 28 labels';
	$tmp.unlink;
};

subtest 'revision pinning — get-tokenizer accepts :revision' => {
	plan 1;
	# The pinned revision's config.json is stable; re-fetching it
	# twice via the tokenizer-to-file helper yields byte-identical
	# output whether we pin the revision or not (since Cohee's
	# repo hasn't changed). This exercises the :$revision param
	# plumbing on the tokenizer-specific method.
	my IO::Path $tmp = $*TMPDIR.add("hf-test-tok-{$*PID}.json");
	$hf.get-tokenizer-to-file($MODEL-ID, $tmp, :revision($PINNED-REV));
	ok $tmp.s > 100_000, "tokenizer.json is { $tmp.s } bytes";
	$tmp.unlink;
};
